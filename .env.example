# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git (it is in .gitignore).

# Flask signing key — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string.
# Local dev (default): leave unset — the app falls back to SQLite (instance/veloura.db).
# Production (Render): set to your Postgres URL, e.g.
#   postgresql://user:password@host:5432/veloura
DATABASE_URL=

# Cloudinary connection string (used in a later step for product image uploads).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# WhatsApp number for the "Order on WhatsApp" button on product pages.
# Digits only, with country code and NO + or spaces (India example: 91 + 10 digits).
WHATSAPP_NUMBER=919876543210

# Flask environment: development or production
FLASK_ENV=development
